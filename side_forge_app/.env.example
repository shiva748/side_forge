# Side Forge Mobile — Environment Configuration
# Copy this file to `.env` and adjust the backend URL for your target device.
#
# 1. Android Emulator (Android Studio AVD):
#    EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
#
# 2. Physical Android or iOS Device on the same Wi-Fi LAN:
#    Replace 192.168.1.100 with your development machine's LAN IPv4 address:
#    EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8080
#
# 3. iOS Simulator (macOS):
#    EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_DEEP_LINK_SCHEME=sideforge
