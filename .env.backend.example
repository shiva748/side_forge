# ============================================================================
# Side Forge Backend — Hybrid WebSocket + Push Notification Environment Template
# Copy values into your environment variables or application.properties
# (never commit real service-account JSON or .p8 keys).
# ============================================================================

# 1. Real-Time WebSocket (Enabled by default — works out-of-the-box)
NOTIFICATION_WS_ENABLED=true
NOTIFICATION_WS_ENDPOINT=/ws/notifications
NOTIFICATION_WS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006,*
NOTIFICATION_WS_PRESENCE_TTL_SECONDS=75

# 2. Android Push Notifications — Firebase Cloud Messaging (FCM HTTP v1)
# Set NOTIFICATION_FCM_ENABLED=true once you have a Firebase Service Account JSON
NOTIFICATION_FCM_ENABLED=false
NOTIFICATION_FCM_PROJECT_ID=your-firebase-project-id
# Provide EITHER a file path to the downloaded Firebase Service Account JSON:
NOTIFICATION_FCM_CREDENTIALS_PATH=
# OR base64-encoded contents of the Firebase Service Account JSON (for Docker/Cloud):
NOTIFICATION_FCM_CREDENTIALS_JSON_BASE64=
# Must match EXPO_PUBLIC_ANDROID_NOTIFICATION_CHANNEL_ID in side_forge_app/.env
NOTIFICATION_FCM_ANDROID_CHANNEL_ID=sideforge-default

# 3. iOS Push Notifications — Apple Push Notification service (APNs HTTP/2)
# Set NOTIFICATION_APNS_ENABLED=true once you have an Apple Developer .p8 Auth Key
NOTIFICATION_APNS_ENABLED=false
NOTIFICATION_APNS_TEAM_ID=
NOTIFICATION_APNS_KEY_ID=
NOTIFICATION_APNS_BUNDLE_ID=com.sideforge.app
# Provide EITHER a file path to AuthKey_XXXXXX.p8:
NOTIFICATION_APNS_PRIVATE_KEY_PATH=
# OR base64-encoded contents of the .p8 file:
NOTIFICATION_APNS_PRIVATE_KEY_BASE64=
# false = api.sandbox.push.apple.com (development), true = api.push.apple.com (App Store / TestFlight)
NOTIFICATION_APNS_PRODUCTION=false

